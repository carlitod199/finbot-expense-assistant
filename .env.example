# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# Telegram bot token, issued by @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# Google Gemini API key, from https://aistudio.google.com/apikey. Required.
GEMINI_API_KEY=

# Optional. Gemini model used for parsing and advice.
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Optional. Path to the SQLite database file.
# Default: ./finbot.db (relative to the working directory).
# On a host with ephemeral storage, point this at a persistent volume.
FINBOT_DB=./finbot.db

# Optional. IANA timezone used to resolve "today", the current month and the
# current week (Monday-Sunday). Default: UTC
# Examples: Europe/Lisbon, America/New_York, Asia/Tokyo
FINBOT_TZ=UTC

# Optional. Currency symbol printed in front of every amount. Cosmetic only:
# the bot stores plain numbers and never converts between currencies.
# Default: $
FINBOT_CURRENCY=$
